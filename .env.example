# Public origin used by Auth.js. Match the port Nuxt uses locally.
NUXT_AUTH_ORIGIN=http://localhost:3030

# Generate with: openssl rand -base64 32
NUXT_AUTH_SECRET=

# Google OAuth web-client credentials.
# Add ${NUXT_AUTH_ORIGIN}/api/auth/callback/google as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
